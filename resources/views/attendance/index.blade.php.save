@push('scripts')
<script>
    $(function () {
        $.ajaxSetup({ headers: { 'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content') } });

        const date = '{{ $date }}';

        function statusBadge(status, isLate) {
            if (status === 'present') return isLate
                ? '<span class="badge bg-warning">Late</span>'
                : '<span class="badge bg-success">Present</span>';
            if (status === 'absent') return '<span class="badge bg-danger">Absent</span>';
            if (status === 'on_leave') return '<span class="badge bg-info text-dark">On Leave</span>';
            return '<span class="badge bg-secondary">Not Marked</span>';
        }

        // Mark a single student's attendance via AJAX — instant row update
        $(document).on('click', '.mark-btn', function () {
            const $btn = $(this);
            const $row = $btn.closest('tr');
            const studentId = $row.data('student-id');
            const status = $btn.data('status');
            const checkInTime = $row.find('.checkin-time').val();

            $btn.closest('.btn-group').find('button').prop('disabled', true);

            $.ajax({
                url: '{{ route('attendance.mark') }}',
                method: 'POST',
                data: { student_id: studentId, date: date, status: status, check_in_time: checkInTime || null },
                success: function (res) {
                    $row.find('.status-cell').html(statusBadge(res.status, res.is_late));
                },
                error: function () {
                    alert('Failed to save attendance.');
                },
                complete: function () {
                    $btn.closest('.btn-group').find('button').prop('disabled', false);
                }
            });
        });

        // Bulk mark everyone who hasn't been marked yet as present
        $('#mark-all-present').on('click', function () {
            const $btn = $(this).prop('disabled', true).text('Marking...');

            $.ajax({
                url: '{{ route('attendance.mark-all-present') }}',
                method: 'POST',
                data: { date: date },
                success: function (res) {
                    alert(`Marked ${res.marked_count} unmarked student(s) as present.`);
                    location.reload();
                },
                error: function () {
                    alert('Failed to bulk mark attendance.');
                    $btn.prop('disabled', false).html('<i class="bi bi-check2-all"></i> Mark All Unmarked Present');
                }
            });
        });
    });
</script>
@endpush
